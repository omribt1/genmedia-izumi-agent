# Local development environment configuration
# Copy to .env.local and fill in your values

GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True

# mTLS fix for local development (per README troubleshooting guide)
GOOGLE_API_USE_MTLS=never
GOOGLE_API_USE_CLIENT_CERTIFICATE=false

# Leave blank for default Firestore database
FIRESTORE_DATABASE_ID=

# GCS bucket for asset storage
ASSET_SERVICE_GCS_BUCKET=your-gcp-project-id-izumi-assets

# Deployment mode: "local" runs the full ADK server in-process
DEPLOYMENT_MODE=local
