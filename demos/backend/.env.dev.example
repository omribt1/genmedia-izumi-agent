# Cloud deployment environment configuration
# Copy to .env.dev and fill in your values
# Used by: ./scripts/deploy-to-cloud-run.sh --app_env dev

GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=True

FIRESTORE_DATABASE_ID=
ASSET_SERVICE_GCS_BUCKET=your-gcp-project-id-izumi-assets
ARTIFACT_SERVICE_GCS_BUCKET=your-gcp-project-id-izumi-assets

# Cloud Run deployment config
CLOUD_RUN_SERVICE_NAME=izumi-studio-dev
CLOUD_BUILD_SERVICE_ACCOUNT_EMAIL=PROJECT_NUMBER-compute@developer.gserviceaccount.com

# Agent Runtime sidecar mode
# Set DEPLOYMENT_MODE=agent_runtime to run as a sidecar proxying to Agent Runtime
# Set DEPLOYMENT_MODE=local to run the full ADK server in-process on Cloud Run
DEPLOYMENT_MODE=agent_runtime
AGENT_ENGINE_RESOURCE_NAME=projects/PROJECT_NUMBER/locations/us-central1/reasoningEngines/ENGINE_ID
